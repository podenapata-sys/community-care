rules_version = '2';

// Community Care Hospital — booking security rules.
//
//   Public (website visitors): can create an online booking through the
//     counter/limit transaction in assets/firebase-db.js. Cannot read any booking.
//   Staff (signed in AND listed in /staff/{uid}): read bookings, add manual
//     bookings, change status / fee, move a booking to the recycle bin and back.
//     Permanent delete only after 30 days in the bin.
//   Doctors (signed in AND listed in /doctors/{uid} with their name): read only
//     their own bookings and mark them arrived.
//   Reporters (signed in AND listed in /reporters/{uid}): read bookings only —
//     used by the daily report email script.
//
// Integrity without Cloud Functions: a booking is only accepted when, at the end
// of the same transaction, counters/{date|doctor}.n equals its serialNo, and (for
// online bookings) limits/{date|phone}.n is at most 3.

service cloud.firestore {
  match /databases/{database}/documents {

    function path(col, id) { return /databases/$(database)/documents/$(col)/$(id); }

    function isStaff() {
      return request.auth != null && exists(path('staff', request.auth.uid));
    }

    // Read-only accounts (e.g. the daily report script) — listed in /reporters/{uid}.
    function isReader() {
      return isStaff() || (request.auth != null && exists(path('reporters', request.auth.uid)));
    }

    // Doctor accounts — listed in /doctors/{uid} with the doctor's name exactly as
    // stored on bookings. They see and update only their own patients.
    function isDoctor() {
      return request.auth != null && exists(path('doctors', request.auth.uid));
    }
    function myDoctor() {
      return get(path('doctors', request.auth.uid)).data.doctor;
    }

    function optString(b, k, max) {
      return !(k in b) || b[k] == null || (b[k] is string && b[k].size() <= max);
    }

    // bookingDate is "YYYY-MM-DD", from yesterday up to 60 days ahead.
    function dateOk(d) {
      return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && timestamp.date(int(d[0:4]), int(d[5:7]), int(d[8:10])) > request.time - duration.value(2, 'd')
        && timestamp.date(int(d[0:4]), int(d[5:7]), int(d[8:10])) < request.time + duration.value(61, 'd');
    }

    function validBooking(b) {
      return b.keys().hasOnly(['serialNo', 'bookingDate', 'doctor', 'dept', 'patientName', 'phone',
                               'age', 'note', 'status', 'source', 'createdAt', 'updatedAt', 'fee', 'paid',
                               'deletedAt', 'deletedBy'])
        && b.keys().hasAll(['serialNo', 'bookingDate', 'doctor', 'patientName',
                            'status', 'source', 'createdAt', 'updatedAt'])
        && b.serialNo is int && b.serialNo >= 1
        && dateOk(b.bookingDate)
        && b.doctor is string && b.doctor.size() >= 2 && b.doctor.size() <= 120 && !b.doctor.matches('.*[/|].*')
        && b.patientName is string && b.patientName.size() >= 2 && b.patientName.size() <= 80
        && (validPhone(b) || (b.source == 'manual' && (!('phone' in b) || b.phone == null)))
        && feeOk(b)
        && (!('age' in b) || b.age == null || (b.age is int && b.age >= 0 && b.age <= 120))
        && optString(b, 'dept', 40)
        && optString(b, 'note', 500)
        && b.status == 'new'
        && !('deletedAt' in b) && !('deletedBy' in b)
        && b.createdAt == request.time && b.updatedAt == request.time
        && getAfter(path('counters', b.bookingDate + '|' + b.doctor)).data.n == b.serialNo;
    }

    function validPhone(b) {
      return 'phone' in b && b.phone is string && b.phone.matches('^01[3-9][0-9]{8}$');
    }

    // Visit fee (BDT) and paid flag: optional, only staff may set them.
    function feeOk(b) {
      return (!('fee' in b) || b.fee == null || (b.fee is int && b.fee >= 0 && b.fee <= 100000))
        && (!('paid' in b) || b.paid == null || b.paid is bool);
    }

    // Recycle bin: a soft delete stamps the server time and the staff member's own
    // email; a restore clears both. Nothing else about the delete can be faked.
    function binOk(before, after) {
      return (after.get('deletedAt', null) == before.get('deletedAt', null)
              && after.get('deletedBy', null) == before.get('deletedBy', null))
        || (after.get('deletedAt', null) == request.time
            && after.get('deletedBy', null) == request.auth.token.email)
        || (after.get('deletedAt', null) == null && after.get('deletedBy', null) == null);
    }

    function withinDailyLimit(b) {
      return getAfter(path('limits', b.bookingDate + '|' + b.phone)).data.n <= 3;
    }

    match /bookings/{id} {
      allow create: if validBooking(request.resource.data)
        && ((request.resource.data.source == 'online' && validPhone(request.resource.data)
             && !('fee' in request.resource.data) && !('paid' in request.resource.data)
             && withinDailyLimit(request.resource.data))
            || (request.resource.data.source == 'manual' && isStaff()));
      allow read: if isReader() || (isDoctor() && resource.data.doctor == myDoctor());
      // A doctor may only mark their own (not deleted) patient as arrived.
      allow update: if isDoctor() && !isStaff()
        && resource.data.doctor == myDoctor()
        && resource.data.get('deletedAt', null) == null
        && resource.data.status in ['new', 'confirmed']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'arrived'
        && request.resource.data.updatedAt == request.time;
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt', 'fee', 'paid', 'deletedAt', 'deletedBy'])
        && binOk(resource.data, request.resource.data)
        && request.resource.data.status in ['new', 'confirmed', 'arrived', 'cancelled']
        && feeOk(request.resource.data)
        && request.resource.data.updatedAt == request.time;
      // Permanent removal only after 30 days in the recycle bin.
      allow delete: if isStaff() && resource.data.get('deletedAt', null) != null
        && resource.data.deletedAt < request.time - duration.value(30, 'd');
    }

    // Per doctor per day serial counter. Readable by id only (no listing).
    match /counters/{id} {
      allow get: if true;
      allow create: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
    }

    // Per phone per day booking count (anti-spam). Readable by id only.
    match /limits/{id} {
      allow get: if true;
      allow create: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1 && request.resource.data.n <= 3;
    }

    // Read-only report accounts — managed only from the Firebase console.
    match /reporters/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }

    // Doctor accounts — managed only from the Firebase console.
    match /doctors/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }

    // Staff allowlist — managed only from the Firebase console.
    match /staff/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }
  }
}
